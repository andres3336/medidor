{
  "name": "medidor-aya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Medidor AYA — medición, consumo por ciclo, proyección y CSV crudo; offline-first",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
